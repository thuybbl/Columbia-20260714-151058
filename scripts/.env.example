# 260714-001-Columbia — local secrets for release scripts
# Copy to scripts/.env (gitignored). Do not commit real tokens.

# secret

# Signing (bootstrap-ci: alias key0, both passwords = applicationId)
KEY_PASSWORD=
KEY_ALIAS=key0
KEYSTORE_PASSWORD=
KEYSTORE_BASE64=

# Firebase PRODUCTION for CI (base64 of app/google-services.json) — THỦ CÔNG
GOOGLE_SERVICES_JSON_BASE64=

# Play deploy (base64 JSON service account) — per store, khi có
PLAY_SERVICE_ACCOUNT_JSON=
PLAY_PACKAGE_NAME=com.binarybridge.ai.columbia

# GitHub API cho script local (release.sh / trigger-workflow) — KHÔNG đẩy lên Actions
GITHUB_TOKEN=ghp_your_token_here

# var
